# HTTP server
PORT=8787
HOST=0.0.0.0
# development | production (production requires APP_SECRET)
NODE_ENV=development

# Required in production: 32+ random chars (e.g. `openssl rand -hex 32`).
# Encrypts stored Upwork OAuth tokens.
APP_SECRET=

# Optional first-run owner password (min 8 chars). If unset, the first browser
# visitor sets the password via a one-time in-browser setup.
OWNER_PASSWORD=

# Owner session lifetime in milliseconds (sliding). Default: 604800000 (7 days)
SESSION_TTL_MS=

# SQLite database location (gitignored, never committed)
DATA_DIR=./data

# Official Upwork MCP server endpoint
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
