# HTTP server
PORT=8787
HOST=0.0.0.0
# development | production (production requires APP_SECRET)
NODE_ENV=development

# Required in production: 32+ random chars (e.g. `openssl rand -hex 32`).
# Encrypts stored Upwork OAuth tokens.
APP_SECRET=

# Owner password (min 8 chars) — set at deploy time (the install script
# generates one and prints it once). If left empty, the first browser visitor
# sets the password via a one-time in-browser setup.
OWNER_PASSWORD=

# Owner session lifetime in milliseconds (sliding). Default: 604800000 (7 days)
SESSION_TTL_MS=

# SQLite database location (gitignored, never committed)
DATA_DIR=./data

# Official Upwork MCP server endpoint
UPWORK_MCP_URL=https://mcp.upwork.com/mcp

# Public origin of this app (no trailing slash). Used as the OAuth redirect
# base (PUBLIC_BASE_URL/api/upwork/callback). Defaults to http://localhost:PORT.
# Deploy (plan 09): https://upwork-mcp.ataadevs.net
PUBLIC_BASE_URL=

# Upwork keepalive ping interval in ms. Default: 300000 (5 min), 5000-3600000.
UPWORK_KEEPALIVE_MS=

# Cloudflare Tunnel (plan 09): named-tunnel token from the Cloudflare dashboard
# (Networking → Tunnels). Empty = the tunnel container does not run.
CLOUDFLARE_TUNNEL_TOKEN=

# Compose profiles: `tunnel` activates the cloudflared service (set by the
# install script).
COMPOSE_PROFILES=
